[sub_resource type="GDScript" id="GDScript_yjpwk"]
resource_name = "GlimoraFinal"
script/source = "extends AnimatedSprite2D

var idles := 0

@onready var initial_position := position

func _ready() -> void:
	animation_finished.connect(_on_animation_finished)

func _on_animation_finished() -> void:
	idles += 1
	var attack := idles >= 4
	play(&\"attack\" if attack else &\"idle\")
	if attack:
		position.x = initial_position.x + 170
		position.y = initial_position.y + 25
	else:
		position.x = initial_position.x
		position.y = initial_position.y
	if attack:
		idles = 0
"

