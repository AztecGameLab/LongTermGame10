[sub_resource type="GDScript" id="GDScript_tpouw"]
resource_name = "ScorpionfishFinal"
script/source = "extends AnimatedSprite2D

var idle := true

func _ready() -> void:
	animation_finished.connect(_on_animation_finished)

func _on_animation_finished() -> void:
	play(&\"attack\" if idle else &\"idle\")
	idle = !idle
"

