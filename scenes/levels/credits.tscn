[sub_resource type="GDScript" id="GDScript_nsbf6"]
resource_name = "EyesFinal"
script/source = "extends AnimatedSprite2D

var idles := 0

func _ready() -> void:
	animation_finished.connect(_on_animation_finished)

func _on_animation_finished() -> void:
	idles += 1
	var attack := idles >= 4
	play(&\"status\" if attack else &\"idle\")
	if attack:
		idles = 0
"

